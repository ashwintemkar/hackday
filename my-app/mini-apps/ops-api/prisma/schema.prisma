generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Pod {
  id            String @id @default(cuid())
  name          String @unique
  service       String
  memoryPercent Float
  cpuPercent    Float
  status        String
}

model DeploymentEvent {
  id         String   @id @default(cuid())
  service    String
  version    String
  deployedAt DateTime
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String
  outcome   String
  detail    String?
  createdAt DateTime @default(now())
}
