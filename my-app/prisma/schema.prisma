generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  chats     Chat[]
}

model Chat {
  id           String    @id @default(uuid())
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  userId       String
  messages     Message[]
  files        File[]
  isProcessing Boolean   @default(false)
  folder       String? // To store the folder number/name
}

model Message {
  id        String   @id @default(uuid())
  content   String   @db.Text
  role      String // 'user' or 'assistant'
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    String
}

model File {
  id        String   @id @default(uuid())
  name      String
  path      String
  size      Int
  type      String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    String
}

model Email {
  id           String    @id @default(uuid())
  from         String
  to           String
  subject      String
  body         String    @db.Text
  htmlBody     String?   @db.Text
  messageId    String?   
  inReplyToId  String?  
  inReplyTo    Email?    @relation("EmailThread", fields: [inReplyToId], references: [id], onDelete: SetNull)
  replies      Email[]   @relation("EmailThread")
  receivedAt   DateTime? 
  sentAt       DateTime? 
  direction    EmailDirection
  createdAt    DateTime  @default(now())
  attachments  EmailAttachment[]
}

model EmailAttachment {
  id           String   @id @default(uuid())
  filename     String
  contentType  String
  size         Int
  path         String   // S3 path or other storage reference
  email        Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  emailId      String
  createdAt    DateTime @default(now())
}

model AutoResolution {
  id              String   @id @default(uuid())
  ticketKey       String   @unique
  matchedTicketKey String
  confidence      Float
  resolution      String   @db.Text
  status          String   // 'suggested', 'applied', 'rejected'
  orgId           String
  connectorName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum EmailDirection {
  INCOMING
  OUTGOING
}
