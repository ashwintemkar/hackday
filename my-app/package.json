{
  "name": "ragimplementation",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/dev-logger.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "echo \"No tests specified\" && exit 0",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "node -e \"const { execSync } = require('child_process'); const fs = require('fs'); const path = require('path'); execSync('prisma generate', { stdio: 'inherit' }); const dest = path.join(process.cwd(), 'public', 'vad'); fs.mkdirSync(dest, { recursive: true }); const copy = (src, destName) => { const target = path.join(dest, destName ?? path.basename(src)); fs.copyFileSync(src, target); }; copy(path.join('node_modules', '@ricky0123', 'vad-web', 'dist', 'vad.worklet.bundle.min.js')); copy(path.join('node_modules', '@ricky0123', 'vad-web', 'dist', 'silero_vad_v5.onnx')); copy(path.join('node_modules', '@ricky0123', 'vad-web', 'dist', 'silero_vad_v5.onnx'), 'silero_vad.onnx'); const ortDist = path.join('node_modules', 'onnxruntime-web', 'dist'); if (fs.existsSync(ortDist)) { for (const f of fs.readdirSync(ortDist)) { if (f.endsWith('.wasm') || f.endsWith('.mjs')) { copy(path.join(ortDist, f)); } } }\"",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "prisma:client": "prisma generate",
    "migrate:postgres": "prisma migrate dev",
    "seed:db": "tsx prisma/seed.ts",
    "prisma:migrate": "prisma migrate dev",
    "load-docs": "tsx scripts/load-documents.ts",
    "migrate:deploy": "prisma migrate deploy",
    "worker:temporal": "tsx scripts/temporal-worker.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
