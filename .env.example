# App + vector DB
DATABASE_URL=postgres://ticketly:ticketly@localhost:5432/ticketly

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=ticket-resolution

# Embeddings - local Ollama (nomic-embed-text, 768-dim) for dev/demo
GEMMA_ENDPOINT=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Jarvislabs - serves Gemma for ticket judgement/resolution (lib/jarvislabs/client.ts),
# replacing AWS Bedrock. Put the real API key in your own .env (gitignored), never here.
JARVISLABS_API_KEY=
JARVISLABS_ENDPOINT=https://models.jarvislabs.net/v1
JARVISLABS_MODEL=gemma-4-31b-it

# Jira escalation (file an issue when a ticket is too complex/risky to auto-resolve)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
